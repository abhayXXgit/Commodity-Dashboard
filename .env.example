# ============================================================================
# TransformerProcure Intelligence - environment configuration
# Copy to .env and edit. NEVER commit .env, and never put a key in the frontend.
# ============================================================================

# ---- application ----------------------------------------------------------
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=*

# ---- database -------------------------------------------------------------
# Leave unset to use the bundled SQLite file (zero infrastructure).
# PostgreSQL:
# DATABASE_URL=postgresql+psycopg://procure:procure@localhost:5432/procure
SQL_ECHO=false

# ---- data mode ------------------------------------------------------------
# DEMO -> seeded simulated history, labelled DEMO_DATA everywhere in the UI.
# LIVE -> external adapters are used wherever credentials below are present.
#         Any source without credentials reports UNAVAILABLE; the dashboard
#         then shows "Live data unavailable - last verified price shown".
DATA_MODE=DEMO
STALE_AFTER_HOURS=26

# ---- external price sources (all optional) --------------------------------
# LME data is licensed. Point this at the endpoint your organisation is
# entitled to use, or at a licensed redistributor. Do not scrape.
LME_API_URL=
LME_API_KEY=
METALS_API_URL=
METALS_API_KEY=

# FX. Defaults to a public endpoint; falls back to the constants below and
# labels those values ESTIMATED rather than pretending they are live.
FX_API_URL=https://api.exchangerate.host/latest
FX_API_KEY=
FALLBACK_USDINR=88.50
FALLBACK_EURINR=96.20

# Indian producers publish PDF/Excel circulars and generally offer no open API.
# Default path: drop the official circular into data/imports/ with the producer
# name in the filename (e.g. nalco_2026-09.xlsx) and it is parsed on refresh.
# Set a URL only if you have an entitled endpoint.
NALCO_CIRCULAR_URL=
BALCO_CIRCULAR_URL=
HINDALCO_CIRCULAR_URL=

HTTP_TIMEOUT=15
HTTP_RETRIES=3
HTTP_BACKOFF=1.6

# ---- scheduler (cron syntax) ---------------------------------------------
ENABLE_SCHEDULER=true
DAILY_FETCH_CRON=30 6 * * *
WEEKLY_RETRAIN_CRON=0 3 * * 1
MONTHLY_REPORT_CRON=0 4 1 * *

# ---- analytics / policy ---------------------------------------------------
BACKTEST_FOLDS=3
MIN_HISTORY_POINTS=60
DEFAULT_TAX_PCT=18
ALERT_DAY_MOVE_PCT=2.0
ALERT_FORECAST_MOVE_PCT=5.0
ALERT_SUPPLIER_SPREAD_PCT=1.5
